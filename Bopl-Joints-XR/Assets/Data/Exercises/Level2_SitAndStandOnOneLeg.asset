  m_Name: Level2_SitAndStandOnOneLeg
  m_EditorClassIdentifier: Assembly-CSharp::BoplJoints.Exercises.ExerciseDefinition
  level: 2
  displayName: Sit down, stand up on one leg
  nhsExerciseNumber: 40
  summary: Sit down using both legs, then stand up using only your working leg.
  steps:
  - Stand with a chair behind you.
  - Using both legs, slowly lower yourself down to the chair.
  - Use your working leg to stand up again.
  singleLeg: 1
  defaultRepetitions: 8
  defaultSets: 3
