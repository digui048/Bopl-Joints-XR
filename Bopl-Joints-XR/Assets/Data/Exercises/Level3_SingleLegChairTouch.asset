  m_Script: {fileID: 11500000, guid: bef6e52a1bcc17947934a11e55f1ebae, type: 3}
  m_Name: Level3_SingleLegChairTouch
  m_EditorClassIdentifier: Assembly-CSharp::BoplJoints.Exercises.ExerciseDefinition
  level: 3
  displayName: Single-leg chair touch
  nhsExerciseNumber: 41
  summary: Stand on your working leg, touch the chair briefly and rise again.
  steps:
  - Stand with a chair behind you.
  - Stand on the leg you are working.
  - Lower your bottom down to the chair and touch it briefly. Do not sit down.
  - Rise back up again.
  singleLeg: 1
  defaultRepetitions: 8
  defaultSets: 3
